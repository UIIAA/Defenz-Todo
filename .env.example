# Database Configuration - Neon PostgreSQL
# Para produção/Neon DB (com connection pooling para Vercel/serverless):
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=10"

# Direct connection (sem pooling) para migrations e Prisma Studio:
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Para desenvolvimento local com PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/defenz?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/defenz?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email Configuration (opcional - Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="onboarding@resend.dev"
EMAIL_FROM_NAME="Defenz To-Do"

# API Keys
# GEMINI_API_KEY liga a Ana (IA do Portal) E o relatorio executivo.
# Usar chave com TETO DE GASTO — o rate-limit do app roda em memoria do lambda e nao
# segura custo (feature-portal-ana R5).
GEMINI_API_KEY="AIzaSy..."
ANA_MODEL="gemini-3.6-flash"
ANTHROPIC_API_KEY="sk-ant-xxx"   # nao usado hoje (a Ana roda no Gemini)

# Portal - modo web da Ana (F5). Sem isto o seletor Web aparece desabilitado com explicacao.
N8N_PORTAL_WEB_WEBHOOK_URL=""

# Cron Jobs (Vercel)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Server Configuration
NODE_ENV="development"
PORT="3000"

# Proposta - arquivamento no OneDrive via n8n (F5). Sem isto a proposta e gerada
# e baixada normalmente; o registro so fica marcado como "nao arquivado".
N8N_PROPOSTA_ARQUIVO_WEBHOOK_URL=""
N8N_PROPOSTA_ARQUIVO_TOKEN=""
