{
  "mcpServers": {
    "stitch": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "env": {
        "STITCH_USE_SYSTEM_GCLOUD": "1"
      }
    },
    "shadcn-ui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/shadcn-ui-mcp@latest"
      ],
      "env": {}
    }
  }
}