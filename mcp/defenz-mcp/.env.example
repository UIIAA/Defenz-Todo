# Defenz MCP — configuração de ambiente
# Copie para .env (NUNCA commite o .env com o token real).

# Base da API Defenz (sem barra final).
#   prod : https://defenz-todo.vercel.app
#   dev  : http://localhost:3000
DEFENZ_API_URL=https://defenz-todo.vercel.app

# API Service Token (Bearer) — formato defz_ + 56 hex.
# Gere com:  npx tsx scripts/create-api-token.ts --email seu@email --name minha-mcp
# ou pela UI: Configurações → Usuários → 🔑 API Tokens (admin).
DEFENZ_API_TOKEN=defz_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: timeout das requisições em ms (default 30000).
# DEFENZ_API_TIMEOUT_MS=30000
