// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  password                String
  role                    String                   @default("user")
  position                String?                  // Cargo/funcao
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activities              Activity[]
  auditLogs               AuditLog[]
  accounts                Account[]
  sessions                Session[]
  notificationPreferences NotificationPreferences?
  emailLogs               EmailLog[]
  activityComments        ActivityComment[]
  financialMetrics        FinancialMetric[]
  customerMetrics         CustomerMetric[]
  engagementMetrics       EngagementMetric[]
  productHealthMetrics    ProductHealthMetric[]
  salesMetrics            SalesMetric[]
  activityInsights        ActivityInsight[]
  businessMetrics         BusinessMetric[]
  
  // CRM Relations
  clients                 Client[]
  opportunities           Opportunity[]
  interactions            Interaction[]
  marketingLists          MarketingList[]
  dailyActivityLogs       DailyActivityLog[]
  demandas                Demanda[]
  inviteTokens            InviteToken[]

  @@index([email])
}

// ============================================================
// CRM CORE MODELS
// ============================================================

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  segment   String?  // Ex: Varejo, Indústria, Tecnologia
  notes     String?
  
  // Campos Executivos
  licenseCount Int?
  invoiceValue Float?
  status       String? // Ex: "Implementado"
  billingDate  DateTime?
  origin       String?
  salesCycle   String?
  
  marketingList   MarketingList? @relation(fields: [marketingListId], references: [id])
  marketingListId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  opportunities Opportunity[]

  @@index([userId])
  @@index([email])
  @@index([company])
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("prospecting") // prospecting, qualification, proposal, negotiation, closed_won, closed_lost
  value       Decimal? @default(0)
  probability Int?     @default(0) // 0-100%
  priority    String   @default("medium") // low, medium, high
  
  expectedCloseDate DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Campos Executivos
  responsibleExecutive String?
  licenseCount         Int?
  additionalServices   String?
  origin               String?
  entryDate            DateTime?
  lastContact          DateTime?
  nextAction           String?
  stage                String? // Campo livre para "Proposta Enviada", "Negociação", etc.

  marketingList   MarketingList? @relation(fields: [marketingListId], references: [id])
  marketingListId String?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  interactions      Interaction[]
  activities        Activity[]
  dailyActivityLogs DailyActivityLog[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model Interaction {
  id        String   @id @default(cuid())
  type      String   // call, email, whatsapp, meeting, note
  content   String   // Resumo da interação
  date      DateTime @default(now())
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([opportunityId])
  @@index([date])
}

model Activity {
  id          String            @id @default(cuid())
  priority    Int // 0=Alta, 1=Média, 2=Baixa
  area        String // Marketing, Vendas, Gestão, Estratégico, Back office
  title       String // O Quê? (What) - Título da ação
  description String? // Por Quê? (Why) - Justificativa detalhada
  responsible String? // Quem? (Who) - Responsável pela execução
  deadline    String? // Quando? (When) - Prazo/Timeline
  location    String? // Onde? (Where) - Local/Plataforma de execução
  how         String? // Como? (How) - Método/Processo detalhado
  cost        String? // Quanto? (How Much) - Investimento/Custo
  status      String            @default("pending") // pending, in_progress, completed, ok
  deletedAt   DateTime? // Soft delete
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  comments    ActivityComment[]
  insight     ActivityInsight? // 1:1 com AI insights
  opportunities Opportunity[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([area])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATE, UPDATE, DELETE, IMPORT
  entityType String // Demanda, Activity, User
  entityId   String
  userId     String
  userEmail  String
  changes    String? // JSON string of changes
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NotificationPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  notificationEmail   String?  // Email alternativo para notificacoes (null = usa email de login)
  emailEnabled        Boolean  @default(true) // Master toggle para notificacoes
  activityAssigned    Boolean  @default(true)
  deadlineApproaching Boolean  @default(true)
  statusChanged       Boolean  @default(true)
  activityDeleted     Boolean  @default(true)
  dailyDigest         Boolean  @default(false)
  weeklyReport        Boolean  @default(false)
  
  // CRM Notifications
  opportunityWon      Boolean  @default(true)
  opportunityLost     Boolean  @default(true)
  newLead             Boolean  @default(true)
  interactionLogged   Boolean  @default(true)

  quietHoursStart     String? // e.g., "22:00"
  quietHoursEnd       String? // e.g., "08:00"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MarketingList {
  id                String    @id @default(cuid())
  name              String
  sentDate          DateTime?
  validatedContacts Int       @default(0)
  origin            String?
  callsCount        Int       @default(0)
  emailsCount       Int       @default(0)
  meetingsCount     Int       @default(0)
  proposalsCount    Int       @default(0)
  leadsGenerated    Int       @default(0)
  conversionRate    String?   // Ex: "10%"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  opportunities     Opportunity[]
  clients           Client[]
  dailyActivityLogs DailyActivityLog[]

  @@index([userId])
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String
  emailType  String // assigned, deadline, status_change, deleted, digest, report
  activityId String?
  sentTo     String
  subject    String
  sentAt     DateTime @default(now())
  status     String // sent, failed, bounced
  error      String?
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([emailType])
  @@index([sentAt])
  @@index([status])
}

model ActivityComment {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  userName   String // Denormalizado para performance
  userEmail  String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([activityId, createdAt])
  @@index([userId])
}

// ============================================================
// BUSINESS METRICS (Métricas Operacionais de Negócio)
// ============================================================

// Métricas operacionais do dia-a-dia (não são M&A, são performance pura)
// Exemplos: Tempo de Resposta, Produtividade, Taxa de Conversão, etc.
model BusinessMetric {
  id     String   @id @default(cuid())
  period DateTime  // Mês de referência

  // ========== CATEGORIA DA MÉTRICA ==========
  category String // "operational", "sales", "customer_service", "productivity", "quality"

  // ========== MÉTRICAS OPERACIONAIS ==========
  metricName  String // Nome da métrica (ex: "Tempo Médio de Resposta")
  metricValue Decimal  // Valor da métrica
  metricUnit  String // Unidade (ex: "minutos", "horas", "%", "unidades")
  target      Decimal?  // Meta desejada

  // ========== CONTEXTO ==========
  description String?  // Descrição do que mede
  area        String // Marketing, Vendas, Gestão, Estratégico, Back office

  // ========== METADATA ==========
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? 
  version Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, metricName, version])
  @@index([period(sort: Desc)])
  @@index([category])
  @@index([area])
  @@index([userId])
  @@map("business_metrics")
}

// ============================================================
// AI INSIGHTS PARA ATIVIDADES
// ============================================================

// Insights gerados por IA (Google Gemini) para análise de impacto
// Conecta atividades com Business Metrics (operacionais) E M&A Metrics (valorização)
model ActivityInsight {
  id         String   @id @default(cuid())
  activityId String   @unique // 1:1 com Activity

  // ========== BUSINESS METRICS (Operacionais) ==========
  // Métricas de NEGÓCIO identificadas pela IA
  // Ex: "Tempo de Resposta", "Produtividade", "Taxa de Conversão"
  // Estrutura: [{ name, category, impact, confidence, explanation }]
  businessMetrics     Json 
  businessMetricScore Int // Score agregado 0-100

  // ========== M&A METRICS (Valorização) ==========
  // Métricas de M&A identificadas pela IA
  // Ex: "ARR", "Churn", "LTV:CAC", "EBITDA", "NPS"
  // Estrutura: [{ name, type, impact, confidence, explanation }]
  maMetrics Json 
  maScore   Int // Score agregado 0-100

  // ========== SCORES AGREGADOS ==========
  overallScore Int @default(0) // Score total 0-100 (média ponderada) - calculado automaticamente pelo middleware

  // ========== AI METADATA ==========
  aiModel        String // "gemini-1.5-flash", "gemini-1.5-pro", etc.
  aiConfidence   Decimal  // 0.000-1.000
  processingTime Int // Milissegundos para processar
  tokenCount     Int? // Tokens consumidos (custo tracking)

  // ========== ANALYSIS CONTEXT ==========
  analysisPrompt  String  // Prompt enviado à IA
  rawResponse     String  // Resposta bruta JSON da IA
  analysisVersion String @default("1.0") // Versão do algoritmo de análise

  // ========== AUDIT TRAIL ==========
  createdBy String // userId que solicitou análise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========== RELATIONSHIPS ==========
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdBy], references: [id])

  // ========== INDEXES ==========
  @@index([activityId]) // Lookup rápido por atividade
  @@index([businessMetricScore(sort: Desc)]) // Query top business impact
  @@index([maScore(sort: Desc)]) // Query top M&A impact
  @@index([overallScore(sort: Desc)]) // Query top overall impact
  @@index([createdAt(sort: Desc)]) // Análises recentes
  @@index([aiModel]) // Stats por modelo
  @@index([createdBy]) // Performance para busca por usuário criador
  @@map("activity_insights")
}

// ============================================================
// METRICS PARA VALORIZAÇÃO DO NEGÓCIO (M&A)
// ============================================================

// Métricas Financeiras Principais (snapshot mensal)
model FinancialMetric {
  id     String   @id @default(cuid())
  period DateTime  // Mês de referência (primeiro dia do mês)

  // ARR (Annual Recurring Revenue) - Métrica #1 para SaaS
  mrr            Decimal  // Monthly Recurring Revenue
  arr            Decimal  // ARR = MRR * 12
  newMrr         Decimal  // Novos contratos no mês
  expansionMrr   Decimal  // Upsells/cross-sells
  contractionMrr Decimal  // Downgrades
  churnedMrr     Decimal  // Cancelamentos
  netNewMrr      Decimal  // new + expansion - contraction - churn

  // Growth Metrics
  mrrGrowthRate Decimal  // % crescimento MoM
  arrGrowthRate Decimal  // % crescimento YoY

  // EBITDA (Earnings Before Interest, Taxes, Depreciation, Amortization)
  revenue           Decimal  // Receita total do mês
  cogs              Decimal  // Cost of Goods Sold
  operatingExpenses Decimal  // Despesas operacionais
  ebitda            Decimal  // revenue - cogs - opex
  ebitdaMargin      Decimal  // EBITDA / revenue * 100

  // Gross Margin
  grossProfit Decimal  // revenue - cogs
  grossMargin Decimal  // gross profit / revenue * 100

  // Burn Rate & Runway
  burnRate    Decimal  // Cash queimado por mês
  cashBalance Decimal  // Saldo em caixa
  runway      Int // Meses de runway restantes

  // Rule of 40 (Growth Rate + Profit Margin >= 40%)
  ruleOf40Score Decimal  // arrGrowthRate + ebitdaMargin

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String?  // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// Métricas de Clientes (Churn, LTV, CAC)
model CustomerMetric {
  id     String   @id @default(cuid())
  period DateTime  // Mês de referência

  // Customer Counts
  activeCustomers  Int // Total de clientes ativos
  newCustomers     Int // Novos clientes no mês
  churnedCustomers Int // Clientes que cancelaram
  netNewCustomers  Int // new - churned

  // Churn Metrics (métrica crítica #2)
  customerChurnRate   Decimal  // % de clientes perdidos
  revenueChurnRate    Decimal  // % de MRR perdido (gross churn)
  netRevenueRetention Decimal  // NRR: (MRR start + expansion - churn) / MRR start * 100

  // LTV:CAC Ratio (métrica crítica #3)
  averageLtv       Decimal  // Lifetime Value médio
  averageCac       Decimal  // Customer Acquisition Cost médio
  ltvCacRatio      Decimal  // LTV / CAC (ideal > 3.0)
  cacPaybackMonths Int // Meses para recuperar CAC

  // ARPU (Average Revenue Per User)
  arpu       Decimal  // MRR / activeCustomers
  arpuGrowth Decimal  // % crescimento MoM

  // Cohort Analysis
  cohortMonth         DateTime?  // Mês de aquisição (para análise de cohort)
  cohortSize          Int? // Tamanho do cohort
  cohortRetentionRate Decimal?   // % ainda ativo desde cohortMonth

  // Customer Growth
  customerGrowthRate Decimal  // % crescimento de clientes MoM

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String?  // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([cohortMonth(sort: Desc)])
  @@index([userId])
}

// Métricas de Engajamento (Product-Market Fit)
model EngagementMetric {
  id     String   @id @default(cuid())
  period DateTime  // Mês de referência

  // Activation & Usage
  dau         Int // Daily Active Users (média do mês)
  mau         Int // Monthly Active Users
  wau         Int // Weekly Active Users
  dauMauRatio Decimal  // Stickiness (ideal > 0.2) - precisa 4 decimais

  // Engagement Depth
  avgSessionsPerUser   Decimal  // Média de sessões por usuário/mês
  avgSessionDuration   Int // Minutos médios por sessão
  avgActivitiesPerUser Decimal  // Atividades criadas por usuário

  // Time to Value
  avgTimeToFirstValue Int // Dias até primeira atividade concluída
  activationRate      Decimal  // % de usuários que atingiram value

  // Retention
  weeklyRetention    Decimal  // % ativos 1 semana após signup
  monthlyRetention   Decimal  // % ativos 1 mês após signup
  quarterlyRetention Decimal  // % ativos 3 meses após signup

  // Feature Adoption
  featureAdoptionRates Json?    // { "feature_name": adoption_rate } - jsonb para queries
  powerUserPercentage  Decimal  // % usando >3x por semana

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String?  // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// Métricas de Saúde do Produto (NPS, CSAT, Quality)
model ProductHealthMetric {
  id     String   @id @default(cuid())
  period DateTime  // Mês de referência

  // Customer Satisfaction
  nps  Decimal  // Net Promoter Score (-100 a 100)
  csat Decimal  // Customer Satisfaction (0-100)
  ces  Decimal  // Customer Effort Score (1-7)

  // Product Quality
  bugCount             Int // Bugs reportados no mês
  criticalBugCount     Int // Bugs críticos
  avgBugResolutionTime Int // Horas para resolver bugs

  // Feature Velocity
  featuresShipped       Int // Features entregues no mês
  avgFeatureLeadTime    Int // Dias da ideia até produção
  featureRequestBacklog Int // Requests acumulados

  // Technical Health
  uptime             Decimal  // % uptime (target 99.9900%)
  avgApiResponseTime Int // Milissegundos
  errorRate          Decimal  // % de erros (precisa precisão)

  // Support Quality
  avgSupportResponseTime   Int // Minutos para primeira resposta
  avgSupportResolutionTime Int // Horas para resolução
  supportTicketCount       Int // Total de tickets no mês
  firstContactResolution   Decimal  // % resolvido no primeiro contato

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String?  // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// Métricas de Vendas & Marketing (CAC, Funnel)
model SalesMetric {
  id     String   @id @default(cuid())
  period DateTime  // Mês de referência

  // Sales Performance
  leads          Int // Leads gerados
  qualifiedLeads Int // SQLs (Sales Qualified Leads)
  opportunities  Int // Oportunidades abertas
  closedWon      Int // Deals fechados
  closedLost     Int // Deals perdidos

  // Conversion Rates
  leadToSqlRate         Decimal  // % conversão lead -> SQL
  sqlToOpportunityRate  Decimal  // % conversão SQL -> Opp
  opportunityToWinRate  Decimal  // % conversão Opp -> Win
  overallConversionRate Decimal  // % conversão lead -> Win

  // CAC Breakdown
  marketingSpend Decimal  // Gasto com marketing
  salesSpend     Decimal  // Gasto com vendas
  totalCacSpend  Decimal  // marketing + sales
  blendedCac     Decimal  // CAC total / newCustomers

  // Sales Cycle
  avgSalesCycleLength Int // Dias médios do ciclo de vendas
  avgDealSize         Decimal  // Tamanho médio do contrato

  // Pipeline Health
  pipelineValue    Decimal  // Valor total do pipeline
  pipelineCoverage Decimal  // Pipeline / quota ratio
  leadVelocityRate Decimal  // % crescimento de leads MoM

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String?  // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// ============================================================
// DAILY ACTIVITY LOG (Registro Diário de Atividades)
// ============================================================

// Rastreamento diário de atividades operacionais
// Permite registro rápido de ligações, emails, reuniões e propostas do dia
model DailyActivityLog {
  id   String   @id @default(cuid())
  date DateTime // Data das atividades (sem hora)

  // Contadores de atividades do dia
  calls     Int @default(0) // Ligações realizadas
  emails    Int @default(0) // Emails enviados
  meetings  Int @default(0) // Reuniões realizadas/agendadas
  proposals Int @default(0) // Propostas enviadas

  // Vinculação opcional (contexto)
  marketingListId String? // Opcional: associar a uma lista
  opportunityId   String? // Opcional: associar a uma oportunidade

  // Observações
  notes String? // Notas/contexto do dia

  // Metadata
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingList MarketingList?  @relation(fields: [marketingListId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  // Indexes para performance
  @@index([userId, date(sort: Desc)]) // Buscar atividades por usuário e data
  @@index([date(sort: Desc)]) // Ordenação por data
  @@index([marketingListId]) // Busca por lista
  @@index([opportunityId]) // Busca por oportunidade
  @@map("daily_activity_logs")
}

// ============================================================
// DEMANDAS (Gerenciamento de Demandas com Kanban + Gantt)
// ============================================================

model Demanda {
  id          String    @id @default(cuid())
  title       String
  description String?
  origin      String    @default("outra") // fernando, securisoft, autogerada, outra
  status      String    @default("solicitada") // solicitada, em_andamento, concluida, bloqueada
  priority    String    @default("media") // alta, media, baixa
  assignee       String?   // Pessoa designada para a demanda
  previousStatus String?   // Status anterior quando bloqueada (para lane horizontal)
  dateIn         DateTime  @default(now())
  dateStarted    DateTime?
  deadline    DateTime?
  dateDone    DateTime?
  version     Int       @default(1) // Optimistic locking

  classification String?   // marketing, administrativo, vendas, financeiro, operacional, tecnologia, juridico, rh, estrategico

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subtasks  Subtask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([origin])
  @@index([deadline])
  @@index([assignee])
  @@index([classification])
  @@map("demandas")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  demandaId String
  demanda   Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandaId, position])
  @@map("subtasks")
}

// ============================================================
// CONVITES (Registro por convite apenas)
// ============================================================

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String?   // Email pre-definido (opcional)
  role      String    @default("user")
  usedAt    DateTime? // null = nao usado
  expiresAt DateTime
  createdBy String
  creator   User      @relation(fields: [createdBy], references: [id])
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([createdBy])
}
