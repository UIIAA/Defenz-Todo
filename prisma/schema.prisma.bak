// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  password                String
  role                    String                   @default("user")
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activities              Activity[]
  auditLogs               AuditLog[]
  accounts                Account[]
  sessions                Session[]
  notificationPreferences NotificationPreferences?
  emailLogs               EmailLog[]
  activityComments        ActivityComment[]
  financialMetrics        FinancialMetric[]
  customerMetrics         CustomerMetric[]
  engagementMetrics       EngagementMetric[]
  productHealthMetrics    ProductHealthMetric[]
  salesMetrics            SalesMetric[]
  activityInsights        ActivityInsight[]
  businessMetrics         BusinessMetric[]

  @@index([email])
}

model Activity {
  id          String            @id @default(cuid())
  priority    Int // 0=Alta, 1=Média, 2=Baixa
  area        String // Marketing, Vendas, Gestão, Estratégico, Back office
  title       String // O Quê? (What) - Título da ação
  description String? // Por Quê? (Why) - Justificativa detalhada
  responsible String? // Quem? (Who) - Responsável pela execução
  deadline    String? // Quando? (When) - Prazo/Timeline
  location    String? // Onde? (Where) - Local/Plataforma de execução
  how         String? // Como? (How) - Método/Processo detalhado
  cost        String? // Quanto? (How Much) - Investimento/Custo
  status      String            @default("pending") // pending, in_progress, completed, ok
  deletedAt   DateTime? // Soft delete
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  auditLogs   AuditLog[]
  comments    ActivityComment[]
  insight     ActivityInsight? // 1:1 com AI insights

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([area])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATE, UPDATE, DELETE, etc.
  entityType String // Activity, User, etc.
  entityId   String
  userId     String
  userEmail  String
  changes    String? // JSON string of changes
  createdAt  DateTime @default(now())

  activity Activity? @relation(fields: [entityId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NotificationPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  activityAssigned    Boolean  @default(true)
  deadlineApproaching Boolean  @default(true)
  statusChanged       Boolean  @default(true)
  activityDeleted     Boolean  @default(true)
  dailyDigest         Boolean  @default(false)
  weeklyReport        Boolean  @default(false)
  quietHoursStart     String? // e.g., "22:00"
  quietHoursEnd       String? // e.g., "08:00"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String
  emailType  String // assigned, deadline, status_change, deleted, digest, report
  activityId String?
  sentTo     String
  subject    String
  sentAt     DateTime @default(now())
  status     String // sent, failed, bounced
  error      String?
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([emailType])
  @@index([sentAt])
  @@index([status])
}

model ActivityComment {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  userName   String // Denormalizado para performance
  userEmail  String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([activityId, createdAt])
  @@index([userId])
}

// ============================================================
// BUSINESS METRICS (Métricas Operacionais de Negócio)
// ============================================================

// Métricas operacionais do dia-a-dia (não são M&A, são performance pura)
// Exemplos: Tempo de Resposta, Produtividade, Taxa de Conversão, etc.
model BusinessMetric {
  id     String   @id @default(cuid())
  period DateTime @db.Date // Mês de referência

  // ========== CATEGORIA DA MÉTRICA ==========
  category String // "operational", "sales", "customer_service", "productivity", "quality"

  // ========== MÉTRICAS OPERACIONAIS ==========
  metricName  String // Nome da métrica (ex: "Tempo Médio de Resposta")
  metricValue Decimal @db.Decimal(14, 2) // Valor da métrica
  metricUnit  String // Unidade (ex: "minutos", "horas", "%", "unidades")
  target      Decimal? @db.Decimal(14, 2) // Meta desejada

  // ========== CONTEXTO ==========
  description String? @db.Text // Descrição do que mede
  area        String // Marketing, Vendas, Gestão, Estratégico, Back office

  // ========== METADATA ==========
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? @db.Text
  version Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, metricName, version])
  @@index([period(sort: Desc)])
  @@index([category])
  @@index([area])
  @@index([userId])
  @@map("business_metrics")
}

// ============================================================
// AI INSIGHTS PARA ATIVIDADES
// ============================================================

// Insights gerados por IA (Google Gemini) para análise de impacto
// Conecta atividades com Business Metrics (operacionais) E M&A Metrics (valorização)
model ActivityInsight {
  id         String   @id @default(cuid())
  activityId String   @unique // 1:1 com Activity

  // ========== BUSINESS METRICS (Operacionais) ==========
  // Métricas de NEGÓCIO identificadas pela IA
  // Ex: "Tempo de Resposta", "Produtividade", "Taxa de Conversão"
  // Estrutura: [{ name, category, impact, confidence, explanation }]
  businessMetrics     Json @db.JsonB
  businessMetricScore Int // Score agregado 0-100

  // ========== M&A METRICS (Valorização) ==========
  // Métricas de M&A identificadas pela IA
  // Ex: "ARR", "Churn", "LTV:CAC", "EBITDA", "NPS"
  // Estrutura: [{ name, type, impact, confidence, explanation }]
  maMetrics Json @db.JsonB
  maScore   Int // Score agregado 0-100

  // ========== SCORES AGREGADOS ==========
  overallScore Int @default(0) // Score total 0-100 (média ponderada) - calculado automaticamente pelo middleware

  // ========== AI METADATA ==========
  aiModel        String // "gemini-1.5-flash", "gemini-1.5-pro", etc.
  aiConfidence   Decimal @db.Decimal(4, 3) // 0.000-1.000
  processingTime Int // Milissegundos para processar
  tokenCount     Int? // Tokens consumidos (custo tracking)

  // ========== ANALYSIS CONTEXT ==========
  analysisPrompt  String @db.Text // Prompt enviado à IA
  rawResponse     String @db.Text // Resposta bruta JSON da IA
  analysisVersion String @default("1.0") // Versão do algoritmo de análise

  // ========== AUDIT TRAIL ==========
  createdBy String // userId que solicitou análise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========== RELATIONSHIPS ==========
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdBy], references: [id])

  // ========== INDEXES ==========
  @@index([activityId]) // Lookup rápido por atividade
  @@index([businessMetricScore(sort: Desc)]) // Query top business impact
  @@index([maScore(sort: Desc)]) // Query top M&A impact
  @@index([overallScore(sort: Desc)]) // Query top overall impact
  @@index([createdAt(sort: Desc)]) // Análises recentes
  @@index([aiModel]) // Stats por modelo
  @@index([createdBy]) // Performance para busca por usuário criador
  @@map("activity_insights")
}

// ============================================================
// METRICS PARA VALORIZAÇÃO DO NEGÓCIO (M&A)
// ============================================================

// Métricas Financeiras Principais (snapshot mensal)
model FinancialMetric {
  id     String   @id @default(cuid())
  period DateTime @db.Date // Mês de referência (primeiro dia do mês)

  // ARR (Annual Recurring Revenue) - Métrica #1 para SaaS
  mrr            Decimal @db.Decimal(14, 2) // Monthly Recurring Revenue
  arr            Decimal @db.Decimal(14, 2) // ARR = MRR * 12
  newMrr         Decimal @db.Decimal(14, 2) // Novos contratos no mês
  expansionMrr   Decimal @db.Decimal(14, 2) // Upsells/cross-sells
  contractionMrr Decimal @db.Decimal(14, 2) // Downgrades
  churnedMrr     Decimal @db.Decimal(14, 2) // Cancelamentos
  netNewMrr      Decimal @db.Decimal(14, 2) // new + expansion - contraction - churn

  // Growth Metrics
  mrrGrowthRate Decimal @db.Decimal(6, 2) // % crescimento MoM
  arrGrowthRate Decimal @db.Decimal(6, 2) // % crescimento YoY

  // EBITDA (Earnings Before Interest, Taxes, Depreciation, Amortization)
  revenue           Decimal @db.Decimal(14, 2) // Receita total do mês
  cogs              Decimal @db.Decimal(14, 2) // Cost of Goods Sold
  operatingExpenses Decimal @db.Decimal(14, 2) // Despesas operacionais
  ebitda            Decimal @db.Decimal(14, 2) // revenue - cogs - opex
  ebitdaMargin      Decimal @db.Decimal(6, 2) // EBITDA / revenue * 100

  // Gross Margin
  grossProfit Decimal @db.Decimal(14, 2) // revenue - cogs
  grossMargin Decimal @db.Decimal(6, 2) // gross profit / revenue * 100

  // Burn Rate & Runway
  burnRate    Decimal @db.Decimal(14, 2) // Cash queimado por mês
  cashBalance Decimal @db.Decimal(14, 2) // Saldo em caixa
  runway      Int // Meses de runway restantes

  // Rule of 40 (Growth Rate + Profit Margin >= 40%)
  ruleOf40Score Decimal @db.Decimal(6, 2) // arrGrowthRate + ebitdaMargin

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? @db.Text // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// Métricas de Clientes (Churn, LTV, CAC)
model CustomerMetric {
  id     String   @id @default(cuid())
  period DateTime @db.Date // Mês de referência

  // Customer Counts
  activeCustomers  Int // Total de clientes ativos
  newCustomers     Int // Novos clientes no mês
  churnedCustomers Int // Clientes que cancelaram
  netNewCustomers  Int // new - churned

  // Churn Metrics (métrica crítica #2)
  customerChurnRate   Decimal @db.Decimal(6, 2) // % de clientes perdidos
  revenueChurnRate    Decimal @db.Decimal(6, 2) // % de MRR perdido (gross churn)
  netRevenueRetention Decimal @db.Decimal(6, 2) // NRR: (MRR start + expansion - churn) / MRR start * 100

  // LTV:CAC Ratio (métrica crítica #3)
  averageLtv       Decimal @db.Decimal(14, 2) // Lifetime Value médio
  averageCac       Decimal @db.Decimal(14, 2) // Customer Acquisition Cost médio
  ltvCacRatio      Decimal @db.Decimal(6, 2) // LTV / CAC (ideal > 3.0)
  cacPaybackMonths Int // Meses para recuperar CAC

  // ARPU (Average Revenue Per User)
  arpu       Decimal @db.Decimal(14, 2) // MRR / activeCustomers
  arpuGrowth Decimal @db.Decimal(6, 2) // % crescimento MoM

  // Cohort Analysis
  cohortMonth         DateTime? @db.Date // Mês de aquisição (para análise de cohort)
  cohortSize          Int? // Tamanho do cohort
  cohortRetentionRate Decimal?  @db.Decimal(6, 2) // % ainda ativo desde cohortMonth

  // Customer Growth
  customerGrowthRate Decimal @db.Decimal(6, 2) // % crescimento de clientes MoM

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? @db.Text // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([cohortMonth(sort: Desc)])
  @@index([userId])
}

// Métricas de Engajamento (Product-Market Fit)
model EngagementMetric {
  id     String   @id @default(cuid())
  period DateTime @db.Date // Mês de referência

  // Activation & Usage
  dau         Int // Daily Active Users (média do mês)
  mau         Int // Monthly Active Users
  wau         Int // Weekly Active Users
  dauMauRatio Decimal @db.Decimal(6, 4) // Stickiness (ideal > 0.2) - precisa 4 decimais

  // Engagement Depth
  avgSessionsPerUser   Decimal @db.Decimal(8, 2) // Média de sessões por usuário/mês
  avgSessionDuration   Int // Minutos médios por sessão
  avgActivitiesPerUser Decimal @db.Decimal(8, 2) // Atividades criadas por usuário

  // Time to Value
  avgTimeToFirstValue Int // Dias até primeira atividade concluída
  activationRate      Decimal @db.Decimal(6, 2) // % de usuários que atingiram value

  // Retention
  weeklyRetention    Decimal @db.Decimal(6, 2) // % ativos 1 semana após signup
  monthlyRetention   Decimal @db.Decimal(6, 2) // % ativos 1 mês após signup
  quarterlyRetention Decimal @db.Decimal(6, 2) // % ativos 3 meses após signup

  // Feature Adoption
  featureAdoptionRates Json?   @db.JsonB // { "feature_name": adoption_rate } - jsonb para queries
  powerUserPercentage  Decimal @db.Decimal(6, 2) // % usando >3x por semana

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? @db.Text // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// Métricas de Saúde do Produto (NPS, CSAT, Quality)
model ProductHealthMetric {
  id     String   @id @default(cuid())
  period DateTime @db.Date // Mês de referência

  // Customer Satisfaction
  nps  Decimal @db.Decimal(6, 2) // Net Promoter Score (-100 a 100)
  csat Decimal @db.Decimal(6, 2) // Customer Satisfaction (0-100)
  ces  Decimal @db.Decimal(6, 2) // Customer Effort Score (1-7)

  // Product Quality
  bugCount             Int // Bugs reportados no mês
  criticalBugCount     Int // Bugs críticos
  avgBugResolutionTime Int // Horas para resolver bugs

  // Feature Velocity
  featuresShipped       Int // Features entregues no mês
  avgFeatureLeadTime    Int // Dias da ideia até produção
  featureRequestBacklog Int // Requests acumulados

  // Technical Health
  uptime             Decimal @db.Decimal(6, 4) // % uptime (target 99.9900%)
  avgApiResponseTime Int // Milissegundos
  errorRate          Decimal @db.Decimal(6, 4) // % de erros (precisa precisão)

  // Support Quality
  avgSupportResponseTime   Int // Minutos para primeira resposta
  avgSupportResolutionTime Int // Horas para resolução
  supportTicketCount       Int // Total de tickets no mês
  firstContactResolution   Decimal @db.Decimal(6, 2) // % resolvido no primeiro contato

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? @db.Text // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}

// Métricas de Vendas & Marketing (CAC, Funnel)
model SalesMetric {
  id     String   @id @default(cuid())
  period DateTime @db.Date // Mês de referência

  // Sales Performance
  leads          Int // Leads gerados
  qualifiedLeads Int // SQLs (Sales Qualified Leads)
  opportunities  Int // Oportunidades abertas
  closedWon      Int // Deals fechados
  closedLost     Int // Deals perdidos

  // Conversion Rates
  leadToSqlRate         Decimal @db.Decimal(6, 2) // % conversão lead -> SQL
  sqlToOpportunityRate  Decimal @db.Decimal(6, 2) // % conversão SQL -> Opp
  opportunityToWinRate  Decimal @db.Decimal(6, 2) // % conversão Opp -> Win
  overallConversionRate Decimal @db.Decimal(6, 2) // % conversão lead -> Win

  // CAC Breakdown
  marketingSpend Decimal @db.Decimal(14, 2) // Gasto com marketing
  salesSpend     Decimal @db.Decimal(14, 2) // Gasto com vendas
  totalCacSpend  Decimal @db.Decimal(14, 2) // marketing + sales
  blendedCac     Decimal @db.Decimal(14, 2) // CAC total / newCustomers

  // Sales Cycle
  avgSalesCycleLength Int // Dias médios do ciclo de vendas
  avgDealSize         Decimal @db.Decimal(14, 2) // Tamanho médio do contrato

  // Pipeline Health
  pipelineValue    Decimal @db.Decimal(14, 2) // Valor total do pipeline
  pipelineCoverage Decimal @db.Decimal(6, 2) // Pipeline / quota ratio
  leadVelocityRate Decimal @db.Decimal(6, 2) // % crescimento de leads MoM

  // Audit Trail
  userId  String // Quem inseriu os dados
  user    User    @relation(fields: [userId], references: [id])
  source  String  @default("manual") // manual, api, import, calculated
  notes   String? @db.Text // Contexto/observações
  version Int     @default(1) // Versão dos dados (permite correções)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, version])
  @@index([period(sort: Desc)])
  @@index([userId])
}
